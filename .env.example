# Copy to .env and adjust. Never commit .env.

# --- Backend server (localhost only) ---
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Origins allowed to call the API (frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Paths (relative to project root) ---
DATABASE_URL=sqlite:///database/meeting.db
STORAGE_DIR=storage
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Upload limits ---
MAX_UPLOAD_MB=500
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,mp4

# --- LLM (Ollama, localhost only) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:14b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=16384
LLM_TIMEOUT_SECONDS=900
LLM_KEEP_ALIVE=2m
LLM_CHUNK_CHARS=6000

# --- STT (MLX Whisper) ---
STT_MODEL=mlx-community/whisper-large-v3-turbo
STT_LANGUAGE=ko
STT_CHUNK_SECONDS=600
STT_OVERLAP_SECONDS=10

# --- SMTP (fill in for PHASE 5; use an app password) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Media tools / worker ---
# Command names or absolute paths. /opt/homebrew/bin is searched as a fallback.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
WORKER_POLL_SECONDS=2
