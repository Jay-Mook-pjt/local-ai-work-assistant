# Closed-network (폐쇄망) profile. Copy to .env.offline and start with:
#   APP_ENV_FILE=.env.offline scripts/start.sh prod
# Differences from the development .env are marked [offline].

APP_ENV=production                         # [offline]
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=sqlite:///database/meeting.db
STORAGE_DIR=storage
LOG_DIR=logs
LOG_LEVEL=INFO
MODELS_DIR=models                          # [offline] models/whisper-large-v3-turbo, models/speaker-diarization-community-1

MAX_UPLOAD_MB=500
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,mp4

# --- LLM: local Ollama only ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:14b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=16384
LLM_TIMEOUT_SECONDS=900
LLM_KEEP_ALIVE=2m
LLM_CHUNK_CHARS=6000
LLM_ALLOW_CLOUD=false                      # [offline] refuse :cloud / remote models
LLM_UNLOAD_AFTER_JOB=true                  # free unified memory between jobs (24 GB)

# --- STT / diarization: loaded from MODELS_DIR, never downloaded at runtime ---
STT_MODEL=mlx-community/whisper-large-v3-turbo
STT_LANGUAGE=ko
STT_CHUNK_SECONDS=600
STT_OVERLAP_SECONDS=10
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=auto

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
WORKER_POLL_SECONDS=2

# --- SMTP: internal mail relay only (the one component that needs the network) ---
SMTP_HOST=mail.internal.example            # [offline] 내부 메일 릴레이 주소
SMTP_PORT=25
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_KEYCHAIN_SERVICE=
SMTP_FROM=minutes@internal.example
SMTP_FROM_NAME=AI 회의록 비서
